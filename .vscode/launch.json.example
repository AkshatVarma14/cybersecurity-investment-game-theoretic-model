{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Run Cyber Investment Simulation",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "args": []
        },
        {
            "name": "Python: Run Unit Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "unittest",
            "args": ["discover", "-s", "tests", "-v"],
            "console": "integratedTerminal"
        }
    ]
}
